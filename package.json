{
  "name": "ratedeck",
  "version": "0.1.0",
  "private": true,
  "description": "RateDeck — enterprise VoIP rating, billing and reseller platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "build:libs": "nx run-many -t build --projects=tag:type:lib",
    "dev:api": "nx run @ratedeck/api:dev",
    "dev:worker": "nx run @ratedeck/api:dev:worker",
    "dev:web": "nx run @ratedeck/web:dev",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:generate": "pnpm --filter @ratedeck/api db:generate",
    "db:migrate": "pnpm --filter @ratedeck/api db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "nx": "^21.0.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "~5.7.0",
    "vitest": "^3.0.0"
  }
}
