# ---- Runtime ----
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# ---- PostgreSQL (infra/docker/docker-compose.yml) ----
# Runtime connects as the NON-owner role so Row-Level Security is enforced.
DATABASE_URL=postgres://ratedeck_app:ratedeck_app@localhost:5432/ratedeck
# Migrations run as the schema owner.
MIGRATION_DATABASE_URL=postgres://ratedeck:ratedeck@localhost:5432/ratedeck

# ---- Redis (cache, rate limit, BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Object storage (MinIO locally, S3/GCS in cloud) ----
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ratedeck
S3_ACCESS_KEY=ratedeck
S3_SECRET_KEY=ratedeck-secret

# ---- Mail (Mailpit UI at http://localhost:8025) ----
SMTP_URL=smtp://localhost:1025

# ---- Auth ----
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# ---- Defaults ----
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=Asia/Manila
