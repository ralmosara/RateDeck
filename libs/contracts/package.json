{
  "name": "@ratedeck/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas shared by the NestJS API (validation) and React app (forms, typed clients).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "nx": { "tags": ["type:lib", "scope:shared"] },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.0"
  }
}
